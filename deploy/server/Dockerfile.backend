# Образ бэкенда из готового статического бинарника (собирается на машине разработчика,
# см. deploy.sh) — на сервере не нужен Go-тулчейн. Процесс без root.
FROM alpine:3.22
RUN apk --no-cache add ca-certificates tzdata \
    && addgroup -S app \
    && adduser -S -G app -H -s /sbin/nologin app
COPY vrhome-server /app/server
USER app
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -qO- http://127.0.0.1:8080/api/health >/dev/null || exit 1
ENTRYPOINT ["/app/server"]
