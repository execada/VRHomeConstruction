{
  "name": "vr-home-construction",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate-models": "node scripts/generate-model-list.cjs",
    "predev": "npm run generate-models",
    "dev": "rsbuild dev",
    "prebuild": "npm run generate-models",
    "build": "tsc --noEmit && rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "npm run lint:js && npm run lint:styles && npm run lint:knip",
    "lint:js": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:knip": "knip",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/xr": "^6.6.30",
    "@reduxjs/toolkit": "^2.2.7",
    "@rsbuild/core": "^2.0.3",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rsbuild/plugin-sass": "^1.5.2",
    "classnames": "^2.5.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.1.2",
    "react-router-dom": "7.18.5",
    "redux-saga": "^1.3.0",
    "three": "^0.184.0",
    "typed-redux-saga": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.9.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "knip": "^5.27.3",
    "prettier": "^3.3.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vitest": "5.0.5"
  }
}
