# Скопируйте в .env и подставьте свои значения (файл .env в git не попадает):
#   cp .env.example .env && chmod 600 .env

PORT=8080
MONGO_URI=mongodb://mongodb:27017

# Секрет подписи сессий: не короче 32 байт, случайный. Сгенерировать:
#   openssl rand -hex 48
# В разработке без него сервер создаст временный секрет (после перезапуска нужно войти заново).
JWT_SECRET=

# ─── Продакшен ──────────────────────────────────────────────────────────────
# APP_ENV=production включает release-режим: обязателен настоящий JWT_SECRET,
# коды подтверждения не пишутся в логи (нужна настроенная почта — SMTP или Resend),
# CORS «*» запрещён. Любое значение, кроме development/dev/local, считается продакшеном.
# В docker-compose.prod.yml APP_ENV задаётся автоматически.
# APP_ENV=production

# Origin-ы, которым разрешён CORS (через запятую). В разработке пусто = «*».
# При раздаче фронта через nginx из docker-compose.prod.yml запросы идут с того же
# origin, поэтому достаточно указать адрес сайта:
# ALLOWED_ORIGINS=https://example.com

# Прокси, которым можно доверять X-Forwarded-For (IP или подсети через запятую).
# Пусто — клиентом считается адрес соединения (подделать IP и обойти лимиты нельзя).
# В docker-compose.prod.yml задана подсеть nginx; за внешним балансировщиком
# добавьте и его адреса.
# TRUSTED_PROXIES=172.28.0.0/24

# ─── Почта: откуда уходит код подтверждения ─────────────────────────────────
# Вариант 1 — Resend (HTTP API): достаточно ключа.
# RESEND_API_KEY=
# RESEND_FROM=VR Home <noreply@your-domain.com>

# Вариант 2 — SMTP. Пока SMTP_HOST пустой, код только в логах (разработка):
#   docker compose logs -f backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_LOG_ONLY=true — не отправлять письма, печатать код в лог (только разработка).

# Примеры SMTP_HOST:
#   Gmail:    smtp.gmail.com (пароль приложения, не пароль от аккаунта)
#   Yandex:   smtp.yandex.ru
#   Mail.ru:  smtp.mail.ru
#   Outlook:  smtp.office365.com

# ─── mongo-express (docker-compose.tools.yml, только локально) ───────────────
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=
